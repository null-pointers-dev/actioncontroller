# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://cp:cp@localhost:5432/cp
# 'password' (local) or 'entra' (Azure managed identity, passwordless)
DATABASE_AUTH=password
DATABASE_POOL_MAX=10

# --- Auth (Better Auth + Microsoft Entra ID) -----------------------------------
BETTER_AUTH_SECRET=change-me-to-32-random-bytes
BETTER_AUTH_URL=http://localhost:3003
MICROSOFT_CLIENT_ID=akjsncvsndvvdkn
MICROSOFT_CLIENT_SECRET=skjdnvsdknvklsdnv  
MICROSOFT_TENANT_ID=snweoinfwengnweognewi
# Members of this Entra group become app admins at login (optional)
CP_ADMIN_GROUP_ID=

# --- GitHub ---------------------------------------------------------------------
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
# Required for webhook mode (repo webhooks are registered with this secret)
GITHUB_WEBHOOK_SECRET=
# Public URL GitHub can reach for webhooks (leave empty locally -> polling mode)
PUBLIC_BASE_URL=
# Organisation with SAML SSO for automatic GitHub username lookup (optional)
CP_SAML_ORG=

# --- Secrets ----------------------------------------------------------------------
# In Azure: Key Vault holding GitHub tokens. Locally leave empty and add credentials
# with secret references like "env:GITHUB_TOKEN_1".
KEY_VAULT_URL=
GITHUB_TOKEN_1=

# --- Worker ----------------------------------------------------------------------------
CP_WORKER_PROCESSING=on
WORKER_HEALTH_PORT=8081

# --- Telemetry ---------------------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Database roles (Azure; leave empty locally) ------------------------------------
# DATABASE_ROLE=cp_worker            # or cp_web for the web app
# DATABASE_MIGRATION_ROLE=cp_owner   # schema owner; used for migrations + partitions
