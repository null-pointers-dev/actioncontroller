{
  "name": "workflow-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,magenta \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:web": "next dev",
    "dev:worker": "NODE_OPTIONS=--conditions=react-server tsx watch --env-file=.env.local worker/main.ts",
    "build": "pnpm build:web && pnpm build:worker",
    "build:web": "next build",
    "build:worker": "node scripts/build-worker.mjs",
    "start:web": "node .next/standalone/server.js",
    "start:worker": "node dist/worker.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "package": "node scripts/prepare-artifacts.mjs",
    "db:push": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/db.ts push",
    "db:reset": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/db.ts reset",
    "db:check": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/db.ts check",
    "db:deploy": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/db.ts deploy",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@azure/identity": "^4.10.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "@azure/monitor-opentelemetry": "^1.13.0",
    "@hookform/resolvers": "^5.2.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@trpc/client": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@trpc/tanstack-react-query": "^11.6.0",
    "better-auth": "^1.3.0",
    "bullmq": "^6.3.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.0",
    "lucide-react": "^0.540.0",
    "next": "^16.3.0",
    "nuqs": "^2.6.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.3.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
